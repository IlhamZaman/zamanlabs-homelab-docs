[defaults]
inventory = inventory.ini
host_key_checking = True
retry_files_enabled = False
stdout_callback = default
interpreter_python = auto_silent
timeout = 20
private_key_file = ~/.ssh/alma_mgmt
forks = 15

[ssh_connection]
ssh_args = -C -o ControlMaster=auto -o ControlPersist=120s -o UserKnownHostsFile=/home/$USER/.ssh/KNOWN_HOSTS_FILE -o StrictHostKeyChecking=yes
pipelining = True

[privilege_escalation]
become = True
become_method = sudo
become_ask_pass = False
